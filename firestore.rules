rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isApprovedTeacher() {
      return signedIn() && me().role == 'teacher' && me().status == 'approved';
    }
    // The seeded admin(s) — keep this list in sync with src/lib/admin.ts.
    function isAdmin() {
      return signedIn() && request.auth.token.email in ['ramalusubov@gmail.com'];
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ── User profiles ──
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isApprovedTeacher() || isAdmin());

      // Only the seeded admin may create an admin profile.
      allow create: if request.auth.uid == userId
                    && (request.resource.data.role != 'admin' || isAdmin());

      // - Admin: may change anything (e.g. approve a teacher's status).
      // - Owner: may edit their profile but NOT their grades/mastery/role/status.
      // - Approved teacher: may edit ONLY grades/mastery (on any student).
      allow update: if isAdmin()
                    || (request.auth.uid == userId && !changedKeys().hasAny(['grades', 'mastery', 'role', 'status']))
                    || (isApprovedTeacher() && changedKeys().hasOnly(['grades', 'mastery']));

      allow delete: if false;

      // ── AI Scavenger-Hunt evidence (users/{uid}/evidence/{autoId}) ──
      // Students write their own finds; teachers/admins read them and may set a
      // manual-review verdict (e.g. teacherApproved) on a fallback submission.
      match /evidence/{evidenceId} {
        allow read:   if signedIn() && (request.auth.uid == userId || isApprovedTeacher() || isAdmin());
        allow create: if request.auth.uid == userId;
        allow update: if isAdmin() || isApprovedTeacher();
        allow delete: if request.auth.uid == userId || isAdmin();
      }
    }

    // ── Teacher identity verifications ──
    match /verifications/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth.uid == uid || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Classes (doc id = the 6-char join code) ──
    match /classes/{classId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.teacherId == request.auth.uid;

      match /roster/{studentId} {
        function classTeacher() {
          return get(/databases/$(database)/documents/classes/$(classId)).data.teacherId;
        }
        function isClassmate() {
          return exists(/databases/$(database)/documents/classes/$(classId)/roster/$(request.auth.uid));
        }
        // Classmates may read each other's roster entries (name + leaderboard
        // stats only — never the full user profile, which stays owner/teacher).
        allow read: if signedIn() && (request.auth.uid == studentId || classTeacher() == request.auth.uid || isClassmate());
        allow create, update: if request.auth.uid == studentId;
        allow delete: if request.auth.uid == studentId || classTeacher() == request.auth.uid;
      }
    }

    // ── Duels (async card battles between classmates) ──
    // Both players may read and advance the duel; only a listed player may
    // create it. Turn order is enforced client-side (low stakes: it's a game).
    match /duels/{duelId} {
      allow read: if signedIn() && request.auth.uid in resource.data.players;
      allow create: if signedIn() && request.auth.uid in request.resource.data.players;
      allow update: if signedIn() && request.auth.uid in resource.data.players;
      allow delete: if signedIn() && request.auth.uid in resource.data.players;
    }

    // ── App configuration (module visibility, curated by the admin) ──
    // Public read: the nav must know what to show before/without sign-in.
    // TEMP (owner testing): writes are open to EVERYONE so the /modules
    // curator can be exercised without signing in. Before students use this,
    // restore:  allow write: if isAdmin();
    match /config/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Everything else denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
