rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isApprovedTeacher() {
      return signedIn() && me().role == 'teacher' && me().status == 'approved';
    }
    // The seeded SUPER admin(s) — keep this list in sync with src/lib/admin.ts.
    function isAdmin() {
      return signedIn() && request.auth.token.email in ['ramalusubov@gmail.com', 'superadmin@gmail.com'];
    }
    function isSchoolAdmin() {
      return signedIn() && me().role == 'school_admin';
    }
    // A super admin designated this email as a school admin (see schools.ts).
    function hasSchoolAdminInvite() {
      return signedIn()
        && exists(/databases/$(database)/documents/schoolAdminInvites/$(request.auth.token.email));
    }
    // A school admin provisioned this email as a teacher.
    function hasTeacherInvite() {
      return signedIn()
        && exists(/databases/$(database)/documents/teacherInvites/$(request.auth.token.email));
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ── User profiles ──
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isApprovedTeacher() || isAdmin()
                    || (isSchoolAdmin() && resource.data.schoolId == me().schoolId));

      // Only the seeded super admin may create an admin profile; a
      // school_admin profile only with a matching designation.
      allow create: if request.auth.uid == userId
                    && (request.resource.data.role != 'admin' || isAdmin())
                    && (request.resource.data.role != 'school_admin' || hasSchoolAdminInvite())
                    && (request.resource.data.role != 'teacher' || hasTeacherInvite());

      // - Admin: may change anything (e.g. approve a teacher's status).
      // - Owner: may self-promote to school_admin ONLY with a valid designation.
      // - Owner: may edit their profile but NOT their grades/mastery/role/status.
      // - Approved teacher: may edit grades/mastery, and may clear a student's
      //   class stamp when removing them from a class (adviser item 6).
      allow update: if isAdmin()
                    || (request.auth.uid == userId
                        && changedKeys().hasOnly(['role', 'schoolId', 'lastLoginAt'])
                        && request.resource.data.role == 'school_admin'
                        && hasSchoolAdminInvite())
                    // Owner self-promotes to a provisioned teacher on first sign-in.
                    || (request.auth.uid == userId
                        && changedKeys().hasOnly(['role', 'schoolId', 'status', 'lastLoginAt'])
                        && request.resource.data.role == 'teacher'
                        && request.resource.data.status == 'approved'
                        && hasTeacherInvite())
                    // A school admin may approve/reject teachers in their own school.
                    || (isSchoolAdmin() && resource.data.schoolId == me().schoolId
                        && changedKeys().hasOnly(['status']))
                    || (request.auth.uid == userId && !changedKeys().hasAny(['grades', 'mastery', 'role', 'status']))
                    || (isApprovedTeacher() && changedKeys().hasOnly(['grades', 'mastery', 'classId', 'className', 'pendingClassId', 'pendingClassName']));

      // Super admin may delete a user's profile doc (user management).
      allow delete: if isAdmin();

      // ── AI Scavenger-Hunt evidence (users/{uid}/evidence/{autoId}) ──
      // Students write their own finds; teachers/admins read them and may set a
      // manual-review verdict (e.g. teacherApproved) on a fallback submission.
      match /evidence/{evidenceId} {
        allow read:   if signedIn() && (request.auth.uid == userId || isApprovedTeacher() || isAdmin());
        allow create: if request.auth.uid == userId;
        allow update: if isAdmin() || isApprovedTeacher();
        allow delete: if request.auth.uid == userId || isAdmin();
      }
    }

    // ── Teacher identity verifications ──
    // Reviewed by the super admin OR the teacher's own school admin (Phase 3).
    match /verifications/{uid} {
      function teacherSchoolId() {
        return get(/databases/$(database)/documents/users/$(uid)).data.schoolId;
      }
      function ownSchoolAdmin() {
        return isSchoolAdmin() && teacherSchoolId() == me().schoolId;
      }
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || ownSchoolAdmin());
      allow create, update: if request.auth.uid == uid || isAdmin() || ownSchoolAdmin();
      allow delete: if isAdmin();
    }

    // ── Classes (doc id = the 6-char join code) ──
    match /classes/{classId} {
      // `get` is public so the School Door (/school-signup, /school-login) can
      // confirm a code BEFORE the account exists. Knowing the code is the
      // secret; the doc only exposes the class name + teacher name. Listing
      // (enumeration) stays signed-in-only.
      allow get: if true;
      allow list: if signedIn();
      allow create: if signedIn() && request.resource.data.teacherId == request.auth.uid;
      // The owning teacher manages the class; the super admin may stamp schoolId
      // during migration and oversee (Phase 5).
      allow update, delete: if isAdmin() || (signedIn() && resource.data.teacherId == request.auth.uid);

      match /roster/{studentId} {
        function classTeacher() {
          return get(/databases/$(database)/documents/classes/$(classId)).data.teacherId;
        }
        function isClassmate() {
          return exists(/databases/$(database)/documents/classes/$(classId)/roster/$(request.auth.uid));
        }
        // Classmates may read each other's roster entries (name + leaderboard
        // stats only — never the full user profile, which stays owner/teacher).
        allow read: if signedIn() && (request.auth.uid == studentId || classTeacher() == request.auth.uid || isClassmate());
        // Student may write their own entry; the class teacher may create one on
        // accepting a join request (Phase 4).
        allow create, update: if request.auth.uid == studentId || classTeacher() == request.auth.uid;
        allow delete: if request.auth.uid == studentId || classTeacher() == request.auth.uid;
      }

      // ── Join requests (student requests → teacher accepts, Phase 4) ──
      match /requests/{studentId} {
        function reqClassTeacher() {
          return get(/databases/$(database)/documents/classes/$(classId)).data.teacherId;
        }
        allow read: if signedIn() && (request.auth.uid == studentId || reqClassTeacher() == request.auth.uid);
        allow create: if request.auth.uid == studentId;
        allow delete: if request.auth.uid == studentId || reqClassTeacher() == request.auth.uid;
      }
    }

    // ── Duels (async card battles between classmates) ──
    // Both players may read and advance the duel; only a listed player may
    // create it. Turn order is enforced client-side (low stakes: it's a game).
    match /duels/{duelId} {
      allow read: if signedIn() && request.auth.uid in resource.data.players;
      allow create: if signedIn() && request.auth.uid in request.resource.data.players;
      allow update: if signedIn() && request.auth.uid in resource.data.players;
      allow delete: if signedIn() && request.auth.uid in resource.data.players;
    }

    // ── App configuration (module visibility, curated by the admin) ──
    // Public read: the nav must know what to show before/without sign-in.
    // TEMP (owner testing): writes are open to EVERYONE so the /modules
    // curator can be exercised without signing in. Before students use this,
    // restore:  allow write: if isAdmin();
    match /config/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Schools (multi-tenant) ──
    match /schools/{schoolId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      // Super admin edits anything; a school admin may edit ONLY their own
      // school's branding + code (never adminEmails/createdBy/active).
      allow update: if isAdmin()
        || (isSchoolAdmin() && me().schoolId == schoolId
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name', 'logoUrl', 'brandColor', 'code', 'teacherEmails']));
    }

    // ── School-admin designations (super admin → email → schoolId) ──
    match /schoolAdminInvites/{email} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ── Teacher provisioning (school admin → email → schoolId) ──
    match /teacherInvites/{email} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        || (isSchoolAdmin() && request.resource.data.schoolId == me().schoolId);
      allow delete: if isAdmin()
        || (isSchoolAdmin() && resource.data.schoolId == me().schoolId);
    }

    // ── Audit log (append-only; written by privileged mutations) ──
    // Readable only by the super admin. Any admin/school-admin may append.
    // Never updated or deleted — tamper-evident.
    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isSchoolAdmin();
      allow update, delete: if false;
    }

    // Everything else denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
