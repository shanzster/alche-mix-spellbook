# ── AlcheMix environment ──────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#
#   cp .env.example .env
#
# ⚠️  NEVER prefix a secret with VITE_ — anything VITE_* is inlined into the
#     browser bundle and can be stolen. The AI key is SERVER-ONLY.
#     (See Free-Ai-Implementation-Tutorial.MD §2 — "the golden rule".)

# Google Gemini API key — get a free one at https://aistudio.google.com/apikey
# While this is left as the placeholder below (or unset), all AI features fall
# back to a keyless rule-based mode and submissions are routed to manual review.
GEMINI_API_KEY=__PLACEHOLDER_ADD_YOUR_GEMINI_KEY__

# Optional: override the default model (see tutorial §1).
# GEMINI_MODEL=gemini-2.0-flash
